{
  "name": "blob-arena", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0 --port 4173",
    "dev:server": "node --watch --import tsx server/src/index.ts",
    "build": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run build:server"
  },
  "dependencies": { "ws": "^8.18.3" },
  "devDependencies": { "@types/node": "^22.15.0", "@types/ws": "^8.18.1", "tsx": "^4.20.0", "typescript": "^5.8.3", "vite": "^6.3.6" },
  "engines": { "node": ">=22" }
}
